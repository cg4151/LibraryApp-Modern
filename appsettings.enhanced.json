{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "LibraryApp": "Debug"
    }
  },
  "LogPaths": {
    "System": "logs/system/${shortdate}.log",
    "RfidOperations": "logs/rfid/${shortdate}.log",
    "KohaSync": "logs/koha/${shortdate}.log",
    "CentralSystemSync": "logs/central-system/${shortdate}.log",
    "AuditTrail": "logs/audit/${shortdate}.log",
    "ErrorLog": "logs/error/${shortdate}.log"
  },
  "CentralSystem": {
    "BaseUrl": "https://10.10.10.24/nhrmbase",
    "Services": {
      "Payment": "NHRMPayment.svc",
      "Base": "NHRMBase.svc",
      "Utils": "NHRMUtils.svc"
    },
    "Authentication": {
      "Username": "${CENTRAL_SYSTEM_USER}",
      "Password": "${CENTRAL_SYSTEM_PASSWORD}",
      "UseEnvironmentVariables": true
    },
    "Connection": {
      "Timeout": 30,
      "RetryPolicy": "exponential",
      "MaxRetries": 3,
      "BackoffMultiplier": 2.0
    },
    "Security": {
      "ValidateCertificate": true,
      "TrustSelfSigned": false
    }
  },
  "Koha": {
    "BaseUrl": "http://koha-server:8081",
    "ApiKey": "${KOHA_API_KEY}",
    "UseEnvironmentVariables": true,
    "Timeout": 15,
    "DefaultBranch": "NSBM",
    "ItemTypeMap": {
      "BOOK": "BK",
      "MAGAZINE": "MG",
      "DIGITAL": "DG"
    }
  },
  "RFID": {
    "Enabled": true,
    "DefaultMode": "TCP",
    "ConnectionModes": {
      "TCP": {
        "Enabled": true,
        "ReaderIp": "192.168.1.100",
        "ReaderPort": 10001,
        "ReadTimeout": 5000,
        "WriteTimeout": 8000,
        "Reconnect": {
          "Enabled": true,
          "MaxAttempts": 3,
          "DelayMs": 2000
        }
      },
      "SerialCOM": {
        "Enabled": false,
        "ComPort": "COM1",
        "BaudRate": 9600,
        "DataBits": 8,
        "StopBits": 1,
        "Parity": "None",
        "ReadTimeout": 5000,
        "WriteTimeout": 8000
      }
    },
    "FailoverEnabled": true,
    "FailoverStrategy": "TCPtoSerialCOM",
    "TagEncoding": "UTF-8",
    "ValidationRules": {
      "MinTagLength": 8,
      "MaxTagLength": 128,
      "AllowedCharacters": "alphanumeric"
    },
    "GateOperations": {
      "WriteVerificationEnabled": true,
      "WriteRetries": 2,
      "VerificationDelay": 500
    }
  },
  "Database": {
    "Type": "SQLite",
    "ConnectionString": "Data Source=library.db;Cache=Shared",
    "AutoMigrate": true,
    "BackupOnStartup": true,
    "BackupPath": "backups/"
  },
  "Cache": {
    "Enabled": true,
    "Type": "LocalSqlite",
    "SyncInterval": {
      "Minutes": 5,
      "OnConnection": true
    },
    "OfflineMode": {
      "Enabled": true,
      "QueueChanges": true,
      "MaxQueueSize": 1000
    },
    "CacheItems": [
      "books",
      "patrons",
      "circulation_rules",
      "item_types"
    ]
  },
  "AuditTrail": {
    "Enabled": true,
    "LogRfidWrites": true,
    "LogCheckoutCheckin": true,
    "LogSystemAccess": true,
    "RetentionDays": 365,
    "CsvFormat": {
      "Enabled": true,
      "Delimiter": ",",
      "IncludeTimestamp": true,
      "IncludeOperatorId": true
    },
    "OutputPath": "logs/audit/"
  },
  "Session": {
    "LogoutTimeout": 900,
    "AllowMultipleSessions": false,
    "ActivityTracking": true,
    "TerminalMode": "default"
  },
  "Security": {
    "EncryptSensitiveData": true,
    "EncryptionKey": "${ENCRYPTION_KEY}",
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireSpecialCharacters": true,
      "ExpirationDays": 90
    },
    "Ssl": {
      "Enabled": true,
      "RequireHttps": true
    }
  },
  "UI": {
    "Theme": "Modern",
    "Language": "en-US",
    "DefaultViewMode": "Dashboard",
    "ShowDebugInfo": false,
    "WindowSettings": {
      "RememberPosition": true,
      "DefaultWidth": 1024,
      "DefaultHeight": 768
    }
  },
  "Monitoring": {
    "HealthCheck": {
      "Enabled": true,
      "Interval": 60
    },
    "Metrics": {
      "Enabled": true,
      "CollectionInterval": 300
    }
  }
}
